# BusGo Supabase Configuration
# Copy this file to .env and configure your Supabase project credentials.
# If omitted, BusGo automatically runs in seamless Mock Database mode for offline/local evaluation.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_APP_NAME=BusGo
VITE_APP_TAGLINE="Your Journey, Our Priority"
